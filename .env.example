# Optional settings. Export variables before starting commands; this file is not
# automatically loaded. No credentials or bearer tokens belong here.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Application default is memory. Select sqlalchemy only after migrating the URL.
GEARSHARE_STORE=memory
# Alembic and the sqlalchemy runtime use this same URL.
# Relative paths are relative to backend/ when using the README commands.
GEARSHARE_DATABASE_URL=sqlite:///./gearshare.sqlite3
# Bounded SQLite busy wait in seconds: greater than 0, at most 30.
GEARSHARE_SQLITE_BUSY_TIMEOUT=5
