# Optional settings. Export variables before starting commands; this file is not
# automatically loaded. No credentials or bearer tokens belong here.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Application default is memory. Select sqlalchemy only after migrating the URL.
GEARSHARE_STORE=memory
# Alembic and the sqlalchemy runtime use this same URL.
# Relative paths are relative to backend/ when using the README commands.
GEARSHARE_DATABASE_URL=sqlite:///./gearshare.sqlite3
# Bounded SQLite busy wait in seconds: greater than 0, at most 30.
GEARSHARE_SQLITE_BUSY_TIMEOUT=5

# --- Frontend (Vite) -------------------------------------------------------------------------
# Vite reads these from the shell or from an ignored frontend/.env.local; placeholders only here.
# Adapter: `http` (default when unset) talks to the backend; `mock` is the explicit in-memory demonstration.
VITE_GEARSHARE_SERVICE=http
# API origin the browser calls. Empty = same origin: requests go to /api/v1 and the Vite dev/preview
# proxy forwards them. A cross-origin value needs a backend that allows CORS, which this MVP does not.
VITE_API_BASE_URL=
# Node-side only: where `npm run dev` / `vite preview` forward /api (default http://127.0.0.1:8000).
GEARSHARE_API_PROXY_TARGET=http://127.0.0.1:8000
