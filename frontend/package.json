{
  "name": "gearshare-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/auth.browser.mjs",
    "test:browser:catalogue": "node tests/catalogue.browser.mjs",
    "build": "tsc --noEmit && vite build",
    "test:browser:bookings": "node tests/bookings.browser.mjs",
    "test:browser:resources": "node tests/resources.browser.mjs",
    "test:browser:staff": "node tests/staff.browser.mjs",
    "test:browser:labels": "node tests/staff-labels.qa.browser.mjs",
    "test:browser:http": "node tests/http.browser.mjs",
    "test:browser:http:staff": "node tests/http.staff.browser.mjs",
    "test:browser:http:ux": "node --test tests/http.ux.browser.mjs",
    "test:browser:ux": "node --test tests/ux.mock.browser.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
